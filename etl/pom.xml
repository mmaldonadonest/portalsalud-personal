<?xml version="1.0" encoding="UTF-8"?>
<!--
  portal-salud-etl — migración histórica MariaDB (legacy PHP) → Oracle + filesystem.

  Proyecto INDEPENDIENTE del portal (23-sep-2026). Antes vivía dentro del WAR bajo el perfil
  "etl"; se separó para que el artefacto de producción no lleve el driver de MariaDB ni pueda
  activarse una carga masiva por error. Ver docs/etl-migracion-historica-especificacion.md.

  No es un módulo del pom del portal: se construye aparte con  mvn -f etl/pom.xml package
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.4.3</version>
        <relativePath/>
    </parent>

    <groupId>mx.onest</groupId>
    <artifactId>portal-salud-etl</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>portal-salud-etl</name>
    <description>ETL de migracion historica: servicioMedico.files/tags (MariaDB) -> APP_FS_FILE + MED_TAG (Oracle) + filesystem</description>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.release>21</maven.compiler.release>
        <skipTests>true</skipTests>
    </properties>

    <dependencies>
        <!-- Sin web: es un proceso de consola que corre y termina -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>

        <!-- Destino: Oracle (APP_FS_FILE, MED_TAG) -->
        <dependency>
            <groupId>com.oracle.database.jdbc</groupId>
            <artifactId>ojdbc11</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Origen: MariaDB del legacy PHP -->
        <dependency>
            <groupId>org.mariadb.jdbc</groupId>
            <artifactId>mariadb-java-client</artifactId>
            <scope>runtime</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>portal-salud-etl</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.onest.etl.EtlApplication</mainClass>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <release>${maven.compiler.release}</release>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
